# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL="file:./prisma/dev.db"

# ============================================
# AUTENTICACIÓN
# ============================================
NEXTAUTH_SECRET="tu-secret-muy-seguro-aqui-cambiar"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# SERVICIOS DE NOTIFICACIÓN
# ============================================

# Telegram Bot
# Obtén el token en: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=""

# Slack Webhook
# Crea en: https://api.slack.com/apps
# (Se configura desde la interfaz del panel)

# WhatsApp (Twilio)
# Regístrate en: https://www.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""

# Email (SendGrid)
# Crea cuenta en: https://sendgrid.com
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@tezcapanel.com"

# ============================================
# AGENTE DE SERVIDOR
# ============================================
AGENT_URL="http://localhost:7070"
# Token compartido entre panel y agente. NUNCA se expone al navegador:
# se usa server-side para la API HTTP del agente y como secreto HMAC para
# firmar los tokens efímeros del WebSocket de terminal.
AGENT_TOKEN=""

# --- WebSocket del agente (terminal) ---
# Por defecto el agente escucha SÓLO en 127.0.0.1. El panel hace proxy
# del WS por /ws/terminal vía su custom server (server.js), así no se
# expone un segundo puerto al exterior. No necesitas tocar estas vars
# salvo despliegues exóticos (ej. agente en otra máquina).
# AGENT_WS_HOST="127.0.0.1"
# AGENT_WS_ALLOWED_ORIGINS=""
# AGENT_WS_PORT="7071"

# ============================================
# MODO DE DESARROLLO
# ============================================
NODE_ENV="development"
